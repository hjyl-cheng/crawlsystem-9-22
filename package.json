{
  "name": "crawlsystem-business",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.22.1 <23"
  },
  "packageManager": "npm@9.2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check:safe": "bash scripts/dev/check-safe.sh",
    "typecheck": "tsc --noEmit",
    "test:contracts": "tsx --test packages/contracts/test/*.test.ts",
    "test:auth": "tsx --test apps/control-api/test/*.test.ts",
    "test:console": "npm run test --workspace @crawlsystem/console",
    "test:browser": "npm run test:browser --workspace @crawlsystem/console -- --workers=1",
    "build:console": "npm run build --workspace @crawlsystem/console",
    "build:execution": "node --import tsx apps/execution-worker/scripts/build.ts",
    "test:execution": "node --import tsx --test --test-concurrency=1 packages/execution-client/test/*.test.ts apps/execution-worker/test/*.test.ts",
    "test:temporal": "node --import tsx --test --test-concurrency=1 apps/execution-worker/test/temporal.integration.ts",
    "dev:worker": "node --import tsx apps/execution-worker/src/main.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "migrate": "tsx scripts/dev/migrate.ts",
    "dev:control": "tsx apps/control-api/src/main.ts",
    "dev:ingest": "tsx apps/ingest/src/main.ts",
    "dev:dispatcher": "tsx apps/control-api/src/dispatch-main.ts",
    "console:accounts": "tsx apps/control-api/src/console-accounts.ts",
    "token": "tsx scripts/dev/token.ts",
    "test:http": "tsx --test packages/http/test/*.test.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/common": "1.24.0",
    "@temporalio/testing": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.18.12",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
