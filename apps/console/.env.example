# Public browser configuration only. Never add credentials or signing keys.
VITE_API_BASE_URL=/api
# Normal UI uses account/password login. Only legacy API E2E uses token mode.
# VITE_AUTH_MODE=token
# Used by Vite's development proxy only; production routing is separate.
CONTROL_API_PROXY_TARGET=http://127.0.0.1:18100
# Optional exact HTTPS hostname for the public static preview on port 18103.
# CONSOLE_PREVIEW_HOST=your-preview.trycloudflare.com
# Origin expected by the backend after the preview gateway validates the public origin.
# CONTROL_API_BROWSER_ORIGIN=http://127.0.0.1:18102
