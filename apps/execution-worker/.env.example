CONTROL_API_URL=http://127.0.0.1:18100
INGEST_API_URL=http://127.0.0.1:18101
WORKER_TOKEN_FILE=/absolute/private/worker-token
WORKER_ID=m1-worker-1
SERVER_ID=development-node
BUILD_VERSION=replace-with-build-sha
WORKER_CAPACITY=1
WORKER_HEARTBEAT_MS=20000
WORKER_HTTP_TIMEOUT_MS=5000
WORKER_DRAIN_MS=15000
TEMPORAL_ADDRESS=127.0.0.1:17233
TEMPORAL_NAMESPACE=crawlsystem-m1-main
TEMPORAL_TASK_QUEUE=crawlsystem-m1-main
TEMPORAL_TLS_CA_FILE=/absolute/private/temporal/ca.crt
TEMPORAL_TLS_CERT_FILE=/absolute/private/temporal/tls.crt
TEMPORAL_TLS_KEY_FILE=/absolute/private/temporal/tls.key
TEMPORAL_TLS_SERVER_NAME=temporal-frontend.temporal.svc.cluster.local
# Acceptance-driver-only options; never pass backend env or operator token to Worker.
# EXECUTION_TEMPORAL_EXISTING=true
# OPERATOR_TOKEN_FILE=/absolute/private/operator-token
# EXECUTION_BACKEND_ENV_FILE=/absolute/private/main.env
