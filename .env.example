# Local-only listeners; use the existing TLS ingress/tunnel for remote access.
HOST=127.0.0.1
CONTROL_PORT=18100
INGEST_PORT=18101
CONSOLE_ORIGIN=http://127.0.0.1:18102
DATABASE_URL=postgresql://m1_main_app:REPLACE@127.0.0.1:15432/crawlsystem_m1_main_test
PG_CA_FILE=/absolute/runtime/path/pg-ca.crt
PG_TLS_SERVERNAME=crawler-pg-pool.db.svc.cluster.local
PG_POOL_MAX=4
# Optional only for SIGKILL tests through kubectl: same database via an independent
# 15433 tunnel. A reset connection can terminate an entire kubectl forwarding process.
# M1_CRASH_DATABASE_URL=postgresql://m1_main_app:REPLACE@127.0.0.1:15433/crawlsystem_m1_main_test
M1_JWT_SECRET_FILE=/absolute/runtime/path/jwt-secret
M1_WORKSPACE_ID=m1-main
CONTROL_API_URL=http://127.0.0.1:18100
INGEST_API_URL=http://127.0.0.1:18101
WORKER_TOKEN_FILE=/absolute/runtime/path/worker-token
OPERATOR_TOKEN_FILE=/absolute/runtime/path/operator-token
TEMPORAL_ADDRESS=127.0.0.1:17233
TEMPORAL_NAMESPACE=crawlsystem-m1-main
TEMPORAL_TASK_QUEUE=crawlsystem-m1-main
TEMPORAL_TLS_CA_FILE=/absolute/runtime/path/temporal-ca.crt
TEMPORAL_TLS_CERT_FILE=/absolute/runtime/path/temporal-client.crt
TEMPORAL_TLS_KEY_FILE=/absolute/runtime/path/temporal-client.key
TEMPORAL_TLS_SERVER_NAME=temporal-frontend.temporal.svc.cluster.local
WORKER_ID=m1-worker-1
SERVER_ID=a1-dev
BUILD_VERSION=development
