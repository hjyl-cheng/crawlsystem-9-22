table inet crawlsystem_host {
 set cluster_nodes { type ipv4_addr; elements = { 10.4.4.12, 10.4.4.3, 10.4.4.17, 10.4.4.2, 10.4.4.8, 10.4.4.5 }; }
 set control_nodes { type ipv4_addr; elements = { 10.4.4.12, 10.4.4.2, 10.4.4.8 }; }
 chain input {
  type filter hook input priority -10; policy accept;
  iifname "lo" accept
  ip saddr @control_nodes tcp dport { 2379, 2380 } accept
  tcp dport { 2379, 2380 } counter drop
  ip saddr @cluster_nodes tcp dport { 6443, 10250, 9100 } accept
  ip saddr 10.42.0.0/16 tcp dport { 6443, 10250, 9100 } accept
  tcp dport { 6443, 10250, 9100 } counter drop
  ip saddr @cluster_nodes udp dport 51820 accept
  udp dport 51820 counter drop
 }
}
